# Copy to .env and fill in. Real environment variables override this file.

# From @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABCdefGhIJKlmNoPQRsTUVwxyZ

# The supergroup that hosts one topic per WhatsApp contact.
# Must be a supergroup with Topics enabled, and the bot must be an admin
# with "Manage topics". The id is negative, e.g. -1001234567890.
TELEGRAM_CHAT_ID=-1001234567890

# Optional: only this Telegram user may send messages through the bridge.
# Leave empty to allow every member of the group.
TELEGRAM_OWNER_ID=

# Optional: log in with an 8-digit pairing code instead of scanning a QR code.
# Full international number, no plus sign, e.g. 6281234567890.
WA_PAIR_PHONE=

# Also mirror messages you send from your own phone into the topics.
MIRROR_OWN_MESSAGES=true

# Storage. bridge.db holds the chat<->topic mapping, whatsapp.db the WhatsApp session.
BRIDGE_DB=data/bridge.db
SESSION_DB=data/whatsapp.db

# DEBUG, INFO, WARN or ERROR.
LOG_LEVEL=INFO
